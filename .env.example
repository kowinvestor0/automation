# Copy to .env and fill in. .env is gitignored and never leaves this machine.
# On GitHub these same names go in Settings > Secrets and variables > Actions.

# Script writing. Gemini first - its free tier covers this workload.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Stock footage and photos. Free key from pexels.com/api
PEXELS_API_KEY=

# Publishing. Planly > Settings > Security.
PLANLY_API_KEY=

# Phone notifications when a run finishes. Both are needed, or neither.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Only needed to start a run from inside the desktop app. Scope: workflow.
GITHUB_TOKEN=

# Wikimedia asks for a contact address in the User-Agent. An email is fine.
WIKI_CONTACT=
